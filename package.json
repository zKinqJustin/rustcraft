{
  "name": "rustcraft-ecosystem",
  "version": "1.0.0",
  "description": "Next-Generation Minecraft & Horizon Ecosystem: Launcher, Mod Build System, Web Platform, and API",
  "scripts": {
    "test:backend": "cd backend && node test/api.test.js",
    "test:launcher": "cd launcher && node test/launcher.test.js",
    "test:website": "cd website && node test/website.test.js",
    "test:e2e": "node test/integration.test.js",
    "test": "npm run test:backend && npm run test:launcher && npm run test:website && npm run test:e2e",
    "start:backend": "cd backend && node src/server.js",
    "start:launcher": "launcher-rust\\target\\debug\\rustcraft-launcher.exe",
    "build:launcher": "cd launcher-rust && cargo build --bin rustcraft-launcher",
    "start:website": "cd website && node server.js"
  },
  "keywords": ["rustcraft", "horizon", "minecraft", "launcher", "mods", "hmod"],
  "author": "Rustcraft Contributors",
  "license": "MIT"
}

